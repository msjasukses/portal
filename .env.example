APP_NAME="Portal Siswa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://portal.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database milik Portal Siswa sendiri: hanya sesi, cache, queue, dan
# pengaturan tampilan (nama & logo sekolah).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_siswa
DB_USERNAME=root
DB_PASSWORD=

# Alamat landing page sekolah untuk tombol "Halaman Utama". Kosong = disembunyikan.
LANDING_URL=http://landing-laravel.test

# Database aplikasi sekolah lain (nilai bawaan cocok untuk Laragon).
DATACENTER_DB_HOST=127.0.0.1
DATACENTER_DB_DATABASE=datacenter_v2
DATACENTER_DB_USERNAME=root
DATACENTER_DB_PASSWORD=
ABSENSI_DB_HOST=127.0.0.1
ABSENSI_DB_DATABASE=absensi_sekolah
ABSENSI_DB_USERNAME=root
ABSENSI_DB_PASSWORD=
KURIKULUM_DB_HOST=127.0.0.1
KURIKULUM_DB_DATABASE=kurikulum
KURIKULUM_DB_USERNAME=root
KURIKULUM_DB_PASSWORD=
KESISWAAN_DB_HOST=127.0.0.1
KESISWAAN_DB_DATABASE=kesiswaan
KESISWAAN_DB_USERNAME=root
KESISWAAN_DB_PASSWORD=

# Absensi barcode: aplikasi Absensi (presensi) yang menerbitkan QR di Layar Tap.
# ABSENSI_URL = alamat folder aplikasi Absensi, ABSENSI_BARCODE_KEY = isi
# BARCODE_API_KEY pada config.local.php aplikasi tersebut. Kosong = menu Absen
# Barcode di Portal Siswa dimatikan.
ABSENSI_URL=http://localhost/presensi
ABSENSI_BARCODE_KEY=

# Folder storage/app/public aplikasi Kurikulum (file materi, tugas, jurnal PKL).
# KURIKULUM_STORAGE_PATH=/var/www/kurikulum/storage/app/public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
