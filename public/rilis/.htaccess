# Folder berkas APK rilis aplikasi CyberEdu.
#
# Disajikan Apache sebagai berkas statis, bukan lewat PHP. Alasannya bukan
# kerapian: 26 MB yang mengalir lewat StreamedResponse PHP, dikali satu kelas
# yang menekan Perbarui bersamaan, adalah cara cepat menghabiskan batas proses
# hosting bersama. Apache juga mendukung HTTP Range di sini, sehingga unduhan
# yang terputus di tengah bisa dilanjutkan sendiri tanpa satu baris kode pun.

# Tanpa ini, alamat folder memajang daftar seluruh APK yang pernah dirilis.
Options -Indexes

# Tanpa tipe yang benar, sebagian peramban mengunduh APK sebagai teks dan
# Android menolaknya sebagai "paket rusak".
AddType application/vnd.android.package-archive .apk

<IfModule mod_headers.c>
    # Nama berkas APK selalu memuat nomor versinya, jadi isinya tidak pernah
    # berubah: aman disimpan lama oleh proxy sekolah maupun ponselnya sendiri.
    <FilesMatch "\.apk$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # Manifesnya justru sebaliknya — ia berubah tiap rilis, dan manifes yang
    # tersimpan di cache berarti rilis yang tidak pernah sampai.
    <FilesMatch "^terkini\.json$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
</IfModule>
